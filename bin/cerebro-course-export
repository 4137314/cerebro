#!/bin/sh
# cerebro-course-export -- every document of a course, from its one file.
#
# A course is ONE file: notes/courses/<slug>.org -- metadata, prose, and
# the `* Programme' list of id: links into notes/math/. From it, the four
# documents a course has, one per audience, each a profile of the
# parametric pipeline:
#
#   syllabus   what the course is, in two pages     <- the file itself
#   lecture    what I say at the board              <- + the notes
#   slides     what the room sees                   <- + the notes
#   handbook   what the student keeps               <- + notes, appendices, index
#
# The composition (course + its notes, as #+INCLUDEs) happens inside the
# exporter, into .build/ beside the course -- nothing is generated into
# the repository, and there is no step to remember before compiling. See
# `cerebro-course-source' in .emacs.d/lisp/cerebro-course.el.
#
# What this adds over a bare `make export' is naming: the exporter writes
# its PDF beside the source it compiled, so `handbook' and `slides' --
# both composed from the same course -- would otherwise be the same file,
# each overwriting the last. Here they are collected into
# notes/courses/out/ as <course>-<output>.pdf, gitignored: these are
# derived files, and this repo commits sources.
#
# Usage:
#   cerebro-course-export FILE                 every output, then zip them
#   cerebro-course-export FILE slides          just one
#   cerebro-course-export FILE all --no-zip    everything, no archive
#
# The zip is for handing the course to someone: one file with the
# syllabus, the lecture notes, the slides and the handbook in it.
set -eu

repo_root=$(git rev-parse --show-toplevel)
course=${1:?"usage: cerebro-course-export FILE [OUTPUT|all] [--no-zip]"}
want=${2:-all}
zip_flag=${3:-}

[ -f "$course" ] || {
    echo "cerebro-course-export: no such course file: $course" >&2
    exit 2
}
grep -q '^\*\+[[:space:]]\+Programme[[:space:]]*$' "$course" || {
    echo "cerebro-course-export: $course has no '* Programme' section" >&2
    echo "  (a course is one file that indexes notes -- see bin/cerebro-course)" >&2
    exit 2
}

slug=$(basename "$course" .org)
out="$repo_root/notes/courses/out"

# The four documents, as data: adding one is a line here and a line in
# `cerebro-course-outputs' (which is what Emacs completes over).
outputs='syllabus
lecture
slides
handbook'

mkdir -p "$out"

built=0
for name in $outputs; do
    [ "$want" = "all" ] || [ "$want" = "$name" ] || continue
    echo "cerebro-course-export: $name"
    ( cd "$repo_root" && emacs --batch -l bin/org-export-latex.el -- \
        --profile="$name" "${course#"$repo_root"/}" >/dev/null )
    # Composed sources and every LaTeX product land in .build/ beside the
    # course (see `cerebro-latex-build-directory'); out/ is where the
    # finished documents are collected, one per output name.
    if [ "$name" = "syllabus" ]; then
        produced="$repo_root/notes/courses/.build/$slug.pdf"
    else
        produced="$repo_root/notes/courses/.build/$slug-$name.pdf"
    fi
    [ -f "$produced" ] || {
        echo "cerebro-course-export: $name produced no PDF" >&2
        exit 1
    }
    cp "$produced" "$out/$slug-$name.pdf"
    echo "  -> ${out#"$repo_root"/}/$slug-$name.pdf"
    built=$((built + 1))
done

[ "$built" -gt 0 ] || {
    echo "cerebro-course-export: '$want' is not one of: $(echo $outputs | tr '\n' ' ')" >&2
    exit 1
}

if [ "$want" = "all" ] && [ "$zip_flag" != "--no-zip" ]; then
    if command -v zip >/dev/null 2>&1; then
        archive="$out/$slug.zip"
        rm -f "$archive"
        # -j: a flat archive. Whoever opens it wants the documents, not
        # a reconstruction of this repository's directory layout.
        ( cd "$out" && zip -j -q "$slug.zip" "$slug"-*.pdf )
        echo "cerebro-course-export: ${archive#"$repo_root"/} ($built documents)"
    else
        echo "cerebro-course-export: zip is not on PATH -- PDFs are in ${out#"$repo_root"/}"
    fi
fi
