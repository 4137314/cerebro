#!/bin/sh
# cerebro-new-book -- regenerate a course's book.org from its programme.
#
# A course owns no mathematics: course.org's `* Programme' section is an
# ordered list of id: links to notes in notes/math/, and book.org is the
# *view* of them -- one #+INCLUDE per note, nothing copied. So the book
# is written only once the atomic notes exist, and re-running this after
# editing a note (or reordering the programme) is how the book changes.
#
# The work is done by .emacs.d/lisp/cerebro-course.el through
# bin/cerebro-book.el: resolving an id: link to a file is Org's job, and
# doing it that way is what lets a note be renamed or moved without
# touching any course.
#
# Usage: bin/cerebro-new-book notes/courses/analysis-1
#   (the optional second argument is accepted and ignored: the title
#   comes from course.org's #+COURSE_TITLE:, so there is one place to
#   change it)
set -eu

dir=${1:?"usage: cerebro-new-book DIR"}
repo_root=$(git rev-parse --show-toplevel)

command -v emacs >/dev/null 2>&1 || {
    echo "cerebro-new-book: emacs is not on PATH (run inside 'make shell')" >&2
    exit 1
}

exec emacs --batch -l "$repo_root/bin/cerebro-book.el" -- "$dir"
