#!/bin/sh
# A quick dashboard over the whole cerebro second brain: how many
# notes, how mature, how much has actually been proved (vs asserted),
# and how much task/time activity has gone into it. Mostly glue over
# things already built (the tag taxonomy, Taskwarrior, Timewarrior) --
# see `make stats`. Run inside the guix environment (or via `make
# stats`) so task/timew are on PATH; the note-counting section works
# either way since it's plain grep/find.
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "== Notes =="
# Real content only (mirrors `cerebro-not-a-note-regexp' in
# cerebro-org.el): the directory READMEs, the courses -- a course is an
# index into the notes, not one of them -- and anything under a .build/,
# where a course composed for an export would otherwise be counted as a
# note *and* double every note it includes.
# A function, not a variable of find predicates: unquoted in a variable
# the shell globs `notes/courses/*' against the working directory before
# find ever sees it, and every count came back 0.
note_files() {
    find notes -name '*.org' \
        -not -name 'README.org' \
        -not -path 'notes/courses/*' \
        -not -path '*/.build/*'
}
total=$(note_files | wc -l)
echo "total note files: $total"
for m in seed growing evergreen; do
    n=$(grep -rl ":$m:" notes --include='*.org' 2>/dev/null | wc -l || true)
    echo "  $m: $n"
done

echo
echo "== Rigor =="
# All three greps use ERE (-E) consistently. Only `conjecture' is an
# actual block environment (see latex/cerebro.cls) -- `open_problem' and
# `folklore' are heading *tags*, not blocks, counted separately below;
# counting them as blocks (the old behaviour) always reported 0 and
# implied a `#+begin_open_problem' that would fail to compile.
theorems=$(grep -rohE '^#\+begin_(theorem|lemma|proposition|corollary)' notes --include='*.org' 2>/dev/null | wc -l)
proofs=$(grep -rohE '^#\+begin_proof' notes --include='*.org' 2>/dev/null | wc -l)
conjectures=$(grep -rohE '^#\+begin_conjecture' notes --include='*.org' 2>/dev/null | wc -l)
echo "theorem-like blocks: $theorems"
echo "proof blocks: $proofs"
echo "conjecture blocks: $conjectures"
echo "(run bin/cerebro-lint for exactly which theorems still lack a proof)"

echo
echo "== Epistemic status (heading tags) =="
# The taxonomy's source of truth: conjecture/folklore/open_problem are
# tags (see notes/README.org, cerebro-org.el's org-tag-alist), and are
# what exempt a theorem from needing a proof in bin/cerebro-lint.
for t in conjecture folklore open_problem; do
    n=$(grep -rohE ":${t}:" notes --include='*.org' 2>/dev/null | wc -l)
    echo "  :$t: $n"
done

echo
echo "== Classification (MSC2020) =="
# How much of the database is filed under an MSC code (cerebro-msc.el),
# and which top-level classes it spans. Pure grep/coreutils; the class
# *names* live in cerebro-msc.el -- 'make query Q=by-msc ARGS=46' lists
# the notes under a class, with its name.
# Same note set as the total above, so the "X of Y" is consistent.
with_msc=$(note_files | xargs grep -lE '^#\+MSC:[[:space:]]*[0-9]' 2>/dev/null | wc -l)
echo "notes with an MSC code: $with_msc of $total"
present=$(grep -rhE '^#\+MSC:' notes --include='*.org' 2>/dev/null \
    | sed -E 's/^#\+MSC:[[:space:]]*//' \
    | tr ',[:space:]' '\n\n' \
    | grep -oE '^[0-9][0-9]' | sort | uniq -c | sort -rn)
if [ -n "$present" ]; then
    echo "top-level classes present (count  class):"
    printf '%s\n' "$present" | sed 's/^/  /'
else
    echo "(no MSC codes yet -- add '#+MSC: 46-XX, ...' to your notes)"
fi

echo
echo "== Taskwarrior (academic) =="
if command -v task >/dev/null 2>&1; then
    task rc.verbose=nothing +cerebro count 2>/dev/null || echo "(no matching tasks yet)"
else
    echo "(task not on PATH -- run via 'make stats' or inside the guix environment)"
fi

echo
echo "== Timewarrior (this month) =="
if command -v timew >/dev/null 2>&1; then
    timew summary :month 2>/dev/null || echo "(no time tracked yet)"
else
    echo "(timew not on PATH -- run via 'make stats' or inside the guix environment)"
fi
