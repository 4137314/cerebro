#!/bin/sh
# One-way bridge: Taskwarrior -> Org, for tasks tagged `cerebro' (see
# taskwarrior/hooks/on-add.cerebro, which tags every task under the
# `academic' project automatically). Regenerates agenda/taskwarrior.org
# from scratch every run -- deliberately one-way, not a sync: editing
# the generated file has no effect on Taskwarrior. Edit the task with
# `task' itself; re-run this (or `make ci') to refresh the Org view.
set -eu

repo_root=$(git rev-parse --show-toplevel)
out_dir="$repo_root/agenda"
out_file="$out_dir/taskwarrior.org"
mkdir -p "$out_dir"

{
    printf '#+TITLE: Taskwarrior tasks (generated by bin/task-to-org -- do not edit)\n'
    printf '#+STARTUP: overview\n\n'
    task +cerebro export | jq -r '
        .[] |
        "* " + (if .status == "completed" then "DONE " else "TODO " end) + .description +
        (if .project then "  :" + (.project | gsub("\\."; "_")) + ":" else "" end) + "\n" +
        ":PROPERTIES:\n:TASK_UUID: " + .uuid + "\n:END:\n"
    '
} > "$out_file"

echo "wrote $out_file"
