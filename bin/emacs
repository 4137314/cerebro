#!/bin/sh
# Shim so plain `emacs`, typed interactively from a terminal inside
# this repo, picks up the project-local .emacs.d instead of the
# default ~/.emacs.d. Only reachable via PATH once direnv is active
# (`direnv allow`) and has prepended bin/ ahead of the real emacs (see
# .envrc's `PATH_add bin`); a `guix shell -f guix.scm --` invocation
# (bin/guix-run, `make export`/`ci`/`test`) re-prepends its own
# profile's bin first regardless, so those keep using the real,
# unwrapped emacs, not this script.
#
# `set -u` only (guard unset vars), deliberately not `set -e`: the PATH
# rewrite below pipes through `grep -v`, which exits non-zero when it
# prints no lines -- with `-e` that would abort the shim in the corner
# case where bin/ is the only PATH entry. The other bin/ scripts use
# `set -eu`; this one documents why it can't.
set -u

# Strip our own directory from PATH before re-invoking `emacs`, or
# this would just call itself.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$here")
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v -x "$here" | tr '\n' ':')
export PATH
exec emacs --init-directory="$repo_root/.emacs.d" "$@"
