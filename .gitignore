# LaTeX build artifacts -- regenerate with `make export`/`make ci`,
# never commit them (see githooks/pre-commit).
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.bbl
*.bcf
*.blg
*.run.xml
notes/**/*.pdf
notes/*.pdf
notes/**/*.tex
notes/*.tex

# Org-roam's generated sqlite cache -- rebuilt automatically, not source.
.org-roam.db
.org-roam.db-*

# org-id's id<->file location cache (see cerebro-org.el) -- a rebuildable
# index, not source; regenerated from the notes' own :ID: properties.
.org-id-locations

# Generated by bin/task-to-org -- one-way Taskwarrior -> Org bridge.
/agenda/

# Generated by bin/cerebro-publish-garden -- the HTML "digital garden".
/public/

# Emacs
*~
\#*\#
.\#*

# Emacs' own generated state, all funnelled here by cerebro-session.el:
# custom.el (Customize), backups/, auto-saves/, and the
# recentf/savehist/save-place files. Rebuildable machine state, redirected
# out of the notes tree -- not part of the second brain.
/.emacs.d/var/

# Generated by bin/cerebro-course-export: the course documents (PDF +
# zip). Derived from course.org and the notes it indexes -- this repo
# commits sources.
notes/courses/*/out/
