# LaTeX build artifacts -- regenerate with `make export`/`make ci`,
# never commit them (see githooks/pre-commit).
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.bbl
*.bcf
*.blg
*.run.xml
*.idx
*.ind
*.ilg
notes/**/*.pdf
notes/*.pdf
notes/**/*.tex
notes/*.tex

# Every LaTeX build now happens in a .build/ directory beside the source
# (see `cerebro-latex-build-directory'): the PDF, the .tex and the dozen
# files latexmk keeps for incremental compiles. Derived, never committed.
.build/

# Org-roam's generated sqlite cache -- rebuilt automatically, not source.
.org-roam.db
.org-roam.db-*

# org-id's id<->file location cache (see cerebro-org.el) -- a rebuildable
# index, not source; regenerated from the notes' own :ID: properties.
.org-id-locations

# Generated by bin/task-to-org -- one-way Taskwarrior -> Org bridge.
/agenda/

# Generated by bin/cerebro-publish-garden -- the HTML "digital garden".
/public/

# Emacs
*~
\#*\#
.\#*

# Emacs' own generated state, all funnelled here by cerebro-session.el:
# custom.el (Customize), backups/, auto-saves/, and the
# recentf/savehist/save-place files. Rebuildable machine state, redirected
# out of the notes tree -- not part of the second brain.
/.emacs.d/var/

# Generated by bin/cerebro-course-export: the course documents (PDF +
# zip). Derived from the course file and the notes it indexes -- this
# repo commits sources.
#
# The pattern was `notes/courses/*/out/', from the layout where a course
# was a *directory* holding course.org and book.org. A course has been
# ONE file for a while and its documents are collected one level up, in
# notes/courses/out/, which that pattern does not match. The PDFs stayed
# invisible anyway (`notes/**/*.pdf' above catches them) so nothing
# looked wrong -- but the zip `cerebro-course-export' writes, the single
# artefact whose whole purpose is to be handed to someone, was untracked
# and offered for commit on every run.
notes/courses/out/
