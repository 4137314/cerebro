# Reproducible dev environment for cerebro, pinned via guix/channels.scm.
# See guix.scm and guix/channels.scm for what's in it and why.
#
# NOTE: guix/channels.scm ships as a template until you run, on a machine
# with Guix installed:
#   guix describe -f channels > guix/channels.scm
# Until then, the eval below fails loudly -- expected, see that file.

watch_file guix.scm
watch_file guix/channels.scm

eval "$(guix time-machine -C guix/channels.scm -- shell -f guix.scm --search-paths)"

# Shadow plain `emacs` with bin/emacs (adds --init-directory=.emacs.d)
# so a terminal opened in this directory gets the project config just
# by typing `emacs` -- see that file for why it's safe to shadow.
# Side effect: every other bin/ script also becomes callable by its
# bare name (e.g. `cerebro-issue "..."` instead of `bin/cerebro-issue`).
PATH_add bin
