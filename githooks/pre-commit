#!/bin/sh
# Versioned pre-commit hook for cerebro. Installed via
# `make install-hooks` (git config core.hooksPath githooks) so it lives
# as a tracked file instead of the untracked .git/hooks/. Kept small on
# purpose: the real checks live in bin/ so they can be run by hand too.
#
# Staged filenames are passed NUL-delimited (git -z ... | xargs -0), so
# a note filename with spaces is handled correctly -- no kebab-case
# assumption on the parse check.
set -eu
cd "$(git rev-parse --show-toplevel)"

# Count staged .org files by counting NUL terminators; only spin up the
# (guix) Emacs when there is at least one.
staged_org_count=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.org' \
    | tr -dc '\0' | wc -c)
if [ "$staged_org_count" -gt 0 ]; then
    echo "pre-commit: checking staged .org files parse cleanly..."
    git diff --cached --name-only --diff-filter=ACM -z -- '*.org' \
        | xargs -0 -r ./bin/guix-run emacs --batch -l bin/org-check-staged.el --
fi

artifacts=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '\.(aux|log|out|toc|fls|fdb_latexmk)$|\.synctex\.gz$' || true)
if [ -n "$artifacts" ]; then
    echo "pre-commit: refusing to commit LaTeX build artifacts:"
    echo "$artifacts"
    exit 1
fi

echo "pre-commit: ok"
