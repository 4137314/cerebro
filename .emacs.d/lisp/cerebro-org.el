;;; cerebro-org.el --- base Org-mode setup -*- lexical-binding: t; -*-

(require 'org)
(require 'org-agenda)
(require 'org-id)
(require 'org-refile)
(require 'ispell)
(require 'cerebro-taxonomy) ;; area supertag hierarchy (data), expanded below

(defvar cerebro-root
  (expand-file-name "../.." (file-name-directory (or load-file-name buffer-file-name)))
  "Root of the cerebro repository.")

(setq org-directory (expand-file-name "notes" cerebro-root))

(defconst cerebro-math-directory (expand-file-name "math" org-directory)
  "Where mathematical notes live: notes/math/.

The notes tree has one directory per *kind* of writing, because they have
different lifecycles: `math/' is the permanent concept graph (a note per
definition, theorem, construction -- the thing this repo exists for),
`courses/' is material organised by a course that ends, `daily/' is the
journal. Only this one is a default anywhere: it is where a new note goes
unless you say otherwise (`C-c m ...', `cerebro note new', the org-roam
capture templates -- and bin/cerebro-note mirrors this path, deliberately
duplicated there so the shell tools need no Emacs).

Nothing *requires* a note to be here: `cerebro-note-files' walks the whole
tree, so the graph, the agenda, the linter and every query keep seeing a
note wherever it sits.")

(defun cerebro-note-directories (&optional dir)
  "DIR (default `org-directory') plus every subdirectory under it.
`org-agenda-files' expands a *directory* entry only to the .org files
directly inside it -- it does NOT recurse -- so a lifelong tree like
notes/courses/analysis-1/ and notes/daily/ is invisible to the agenda,
the morning review, and org-drill (whose scope is `agenda') unless
every subdirectory is listed. Listing directories rather than a frozen
file list keeps Org's own re-scan: a note dropped into any known dir
shows up in the agenda with no reload."
  (let ((root (or dir org-directory)))
    (cons root
          (seq-filter #'file-directory-p
                      (directory-files-recursively root "" t)))))

(defun cerebro-note-files (&optional dir)
  "Every real note file under DIR (default `org-directory'), recursively.
All .org files minus the non-note ones: the generated book.org
aggregators and the headingless meta files (README.org, TAGS.org). This
is the single definition of \"where the prose notes are\" -- reused by the
org-ql search surface (cerebro-ql.el) so it can't drift out of sync with
the agenda's directory entries above."
  (seq-remove
   (lambda (f) (string-match-p "/\\(book\\|README\\|TAGS\\)\\.org\\'" f))
   (directory-files-recursively (or dir org-directory) "\\.org\\'")))

(setq org-agenda-files
      (append (cerebro-note-directories)
              (list (expand-file-name "issues/issues.org" cerebro-root)
                    ;; Generated by bin/task-to-org (one-way Taskwarrior bridge).
                    (expand-file-name "agenda/taskwarrior.org" cerebro-root))))

;; The file above doesn't exist until `bin/task-to-org' (or `make ci')
;; has run at least once -- skip it silently rather than erroring,
;; since org-agenda-files entries aren't unconditionally guaranteed to
;; exist by default.
(setq org-agenda-skip-unavailable-files t)

;; Where the Org-roam database lives -- set here, not in cerebro-roam.el,
;; so bin/notes-lint.el and cerebro-query.el can find it without pulling
;; in org-roam-db-autosync-mode or the capture templates. This is a
;; plain defcustom override; it works whether or not org-roam itself is
;; loaded yet.
(setq org-roam-directory org-directory)
(setq org-roam-db-location (expand-file-name ".org-roam.db" cerebro-root))

;; Content is written in English: point flyspell/ispell at the English
;; dictionary shipped by guix.scm (aspell + aspell-dict-en).
(setq ispell-dictionary "en_US")

(setq org-todo-keywords
      '((sequence "TODO(t)" "DOING(g)" "|" "DONE(d)" "CANCELLED(c)")))

(setq org-log-done 'time)
(setq org-startup-indented t)
(setq org-hide-emphasis-markers t)

;; A bare `_' is *not* a subscript here -- only a braced one (`x_{1}') is.
;; Every formula in these notes lives inside a `\(...\)' or `\[...\]'
;; fragment, which Org hands to LaTeX untouched, so an underscore in the
;; surrounding prose is never notation: it is a tag (`open_problem'), a
;; file name, or -- constantly, in a repo that documents its own
;; conventions -- a block name. Left at Org's default, the sentence "use a
;; #+begin_comment block" both *renders* and *exports* as "#+begin" with a
;; subscripted "comment" (seen on screen, in this repo's own exemplar
;; note). Set here rather than in cerebro-appearance.el because
;; bin/org-export-latex.el loads this module and not that one: the screen
;; and the PDF have to make the same choice.
(setq org-use-sub-superscripts '{}
      org-export-with-sub-superscripts '{})

;; -- Durability of the archive ----------------------------------------
;; A second brain meant to outlive many file reorganizations must not
;; depend on file paths. Links are made by :ID: (org-roam gives every
;; node one), so a note keeps resolving after it is renamed or moved.
;; `use-existing' means "prefer an id: link when the target already has
;; an ID" -- it never litters new IDs into files just from storing a
;; link. The id<->file map is cached in a repo-local, gitignored file.
(setq org-id-link-to-org-use-id 'use-existing)
(setq org-id-locations-file (expand-file-name ".org-id-locations" cerebro-root))
(setq org-return-follows-link t)

;; Guard against silently editing text hidden inside a fold -- most
;; importantly an encrypted :crypt: subtree (cerebro-crypt.el): an
;; invisible edit there could corrupt the ciphertext. Show the context
;; and refuse, rather than letting it through. `org-fold-catch-invisible-edits'
;; is the current name (org 9.6+); `org-catch-invisible-edits' is only an
;; obsolete alias for it now -- set whichever this org actually defines, so
;; the config stays warning-free and keeps working if the alias is ever
;; dropped from a future pinned org.
;; `set' on a computed symbol (not `setq') so the byte-compiler doesn't
;; flag the obsolete name it can't prove the runtime guard skips.
(set (if (boundp 'org-fold-catch-invisible-edits)
         'org-fold-catch-invisible-edits
       'org-catch-invisible-edits)
     'show-and-error)

;; Keep state-change and clock logging in a tidy :LOGBOOK: drawer instead
;; of scattered inline lines -- notes stay readable as they accumulate a
;; long history.
(setq org-log-into-drawer t)

;; Refile a heading anywhere in the notes/issues without retyping paths:
;; complete against the full outline of every agenda file.
(setq org-refile-targets '((org-agenda-files :maxlevel . 3)))
(setq org-refile-use-outline-path 'file)
(setq org-outline-path-complete-in-steps nil)
(setq org-refile-allow-creating-parent-nodes 'confirm)

;; Agenda: don't nag about finished items; a week's deadline lead time.
(setq org-deadline-warning-days 7)
(setq org-agenda-skip-scheduled-if-done t)
(setq org-agenda-skip-deadline-if-done t)

;; Cap oversized inline figures (TikZ/plot previews) to a sane width.
(setq org-image-actual-width '(600))

;; Configurable, parametric tag taxonomy: a controlled vocabulary (data,
;; not free text) enforced by completion here and checked for drift by
;; bin/notes-lint.el (any tag NOT in this list is flagged). See
;; notes/TAGS.org for what each one means and when to use it.
;; :startgroup:/:endgroup: make each group mutually exclusive (a note
;; has at most one maturity, one difficulty); epistemic status and the
;; functional tags are free-standing so several can apply at once. The
;; area block is spliced in from cerebro-taxonomy.el as Org group tags
;; (:startgrouptag/:grouptag/:endgrouptag) -- a two-level hierarchy where
;; a supertag (e.g. `analysis') expands to its members
;; (`functional_analysis', ...) in searches and agenda filters.
(setq org-tag-alist
      (append
       '((:startgroup . nil)
         ("seed" . ?s) ("growing" . ?w) ("evergreen" . ?e)
         (:endgroup . nil)
         (:startgroup . nil)
         ("easy" . ?1) ("medium" . ?2) ("hard" . ?3)
         (:endgroup . nil)
         ("conjecture" . ?c) ("folklore" . ?f) ("open_problem" . ?o))
       (cerebro-taxonomy-org-group-tags)
       ;; Functional/structural tags: crypt (encrypted), drill (flashcard),
       ;; daily (an org-roam-dailies journal note -- see cerebro-roam.el).
       '(("crypt" . ?x) ("drill" . ?d) ("daily" . ?y))))

;; MSC2020 (cerebro-msc.el) is recorded per note as a plain `#+MSC:'
;; keyword line, not a tag -- the codes carry punctuation tags can't
;; hold. No registration needed: Org keeps unknown keyword lines, and
;; both the linter and the exporter read them back with
;; `org-collect-keywords'. The codes are validated in bin/notes-lint.el.

;; The agenda custom commands (morning review, issues view) live in their
;; own module, cerebro-agenda.el -- kept out of this base-setup file.

(defun cerebro-interactive-note-buffer-p ()
  "Non-nil when this buffer is a note a *person* is looking at.

The agenda, the start page and org-roam open notes in the background to
read them -- dozens at a time, killed again a moment later. Anything in
`org-mode-hook' that starts a process, a timer or an overlay therefore
runs dozens of times for nothing, in buffers that may be dead before it
answers. That is not hypothetical: live previews, live linting and
`org-appear' between them produced a \"Cache must be active\" error in
the echo area every time the dashboard refreshed its agenda section,
because Org disables its element cache while it prepares those buffers.

Org binds `org-agenda-inhibit-startup' during exactly that preparation,
which is the signal used here. Defined in this module, rather than in
one of the presentation modules, because three of them need it and none
of them should require another."
  (and (buffer-file-name)
       (not noninteractive)
       (not (bound-and-true-p org-agenda-inhibit-startup))
       (not (string-prefix-p " " (buffer-name)))))

(defun cerebro-report (title rows format-row &optional buffer-name)
  "Show ROWS (already sorted/filtered) in a simple read-only report
buffer. TITLE heads it, FORMAT-ROW turns one row into a line,
BUFFER-NAME defaults to *cerebro*. The one report primitive shared by
cerebro-query.el (graph structure) and cerebro-results.el (the results
layer), so every cerebro report looks and behaves the same -- `q' buries
it (special-mode)."
  (let ((buf (get-buffer-create (or buffer-name "*cerebro*"))))
    (with-current-buffer buf
      (let ((inhibit-read-only t))
        (erase-buffer)
        (insert (format "%s\n%s\n\n" title (make-string (length title) ?=)))
        (if (not rows)
            (insert "(nothing found)\n")
          (dolist (r rows) (insert (funcall format-row r) "\n"))))
      (goto-char (point-min))
      (special-mode))
    (display-buffer buf)))

(defun cerebro-known-tags ()
  "Flatten `org-tag-alist' into the actual tag strings, dropping the
group markers (:startgroup:/:endgroup: and the area hierarchy's
:startgrouptag:/:grouptag:/:endgrouptag:, whose car is a keyword, not a
string). Shared by bin/notes-lint.el (flagging undeclared tags) and
cerebro-query.el (tag completion). Includes both area supertags and
subtags, so any declared area tag passes the linter."
  (delq nil (mapcar (lambda (x) (and (consp x) (stringp (car x)) (car x)))
                     org-tag-alist)))

(provide 'cerebro-org)
